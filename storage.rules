rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Draft attachments, uploaded before an order is confirmed/submitted.
    // Path: draft-attachments/{uid}/{attachmentId}-{filename}
    match /draft-attachments/{userId}/{fileName} {
      // Scoped to the owner, matching the write and delete rules below.
      // Previously any authenticated user could read any other user's drafts
      // (FIND-19). Cross-user access for approvers must go through an
      // authorizing callable that mints a short-lived signed URL (FIND-03).
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          // PDF, max 5MB
          (request.resource.contentType == 'application/pdf'
            && request.resource.size < 5 * 1024 * 1024)
          ||
          // Excel (.xlsx / .xls), max 100MB
          (
            (request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
              || request.resource.contentType == 'application/vnd.ms-excel')
            && request.resource.size < 100 * 1024 * 1024
          )
        );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}