rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All access to application data now goes through Cloud Functions,
    // which use the Admin SDK and bypass these rules. Direct client
    // access is denied — this closes the "any authenticated user can
    // read/write everything" hole (STRIDE: Information Disclosure,
    // Tampering, Elevation of Privilege).

    match /orders/{orderId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}